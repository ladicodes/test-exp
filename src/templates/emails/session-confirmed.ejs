<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Session Confirmed</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 30px; text-align: center; border-radius: 8px 8px 0 0; }
        .content { background: #f8f9fa; padding: 30px; border-radius: 0 0 8px 8px; }
        .session-details { background: white; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #28a745; }
        .meeting-link { background: #e3f2fd; padding: 15px; border-radius: 8px; text-align: center; margin: 20px 0; }
        .button { display: inline-block; background: #007bff; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; margin: 10px 5px; }
        .footer { text-align: center; margin-top: 30px; color: #666; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Session Confirmed!</h1>
        </div>
        <div class="content">
            <p>Hello <strong><%= participantName %></strong>,</p>
            
            <p>Great news! Your mentoring session has been confirmed.</p>
            
            <div class="session-details">
                <h3>📋 Confirmed Session Details</h3>
                <p><strong>Title:</strong> <%= sessionTitle %></p>
                <p><strong>Category:</strong> <%= sessionCategory %></p>
                <p><strong>Start Time:</strong> <%= startTime %></p>
                <% if (endTime) { %>
                <p><strong>End Time:</strong> <%= endTime %></p>
                <% } %>
                <% if (description) { %>
                <p><strong>Description:</strong> <%= description %></p>
                <% } %>
                <% if (agenda) { %>
                <p><strong>Agenda:</strong> <%= agenda %></p>
                <% } %>
                <p><strong><%= isStudent ? 'Mentor' : 'Student' %>:</strong> <%= otherParticipantName %> (<%= otherParticipantEmail %>)</p>
                <p><strong>Status:</strong> ✅ Confirmed</p>
            </div>
            
            <% if (meetingLink) { %>
            <div class="meeting-link">
                <h4>🔗 Join the Session</h4>
                <a href="<%= meetingLink %>" class="button">Join Meeting</a>
                <p><small>Meeting Link: <%= meetingLink %></small></p>
            </div>
            <% } %>
            
            <p><strong>Before the Session:</strong></p>
            <ul>
                <li>Add this session to your calendar</li>
                <li>Prepare any questions or materials</li>
                <li>Test your microphone and camera (if applicable)</li>
                <li>Join the meeting 2-3 minutes early</li>
            </ul>
            
            <p><strong>Need to make changes?</strong> Please contact your <%= isStudent ? 'mentor' : 'student' %> directly or reach out to our support team.</p>
            
            <div class="footer">
                <p>Best regards,<br>SquadCo Hackademy Team</p>
                <p><small>Looking forward to a productive mentoring session!</small></p>
            </div>
        </div>
    </div>
</body>
</html>